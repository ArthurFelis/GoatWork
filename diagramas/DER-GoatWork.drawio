        </mxCell>
        <mxCell id="legenda" value="&lt;b&gt;Como ler:&lt;/b&gt; o diagrama segue o fluxo do sistema, de cima para baixo (fases 1 a 5). &lt;i&gt;PK&lt;/i&gt; = chave primária · &lt;i&gt;FK&lt;/i&gt; = chave estrangeira · caixas tracejadas = repetição de uma entidade já mostrada, só para evitar linhas cruzadas · linhas animadas = caminho principal do serviço." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="45" width="1590" height="34" as="geometry"/>
        </mxCell>
